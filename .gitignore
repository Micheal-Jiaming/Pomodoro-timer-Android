*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/

# Published APK — regenerated by android-build\build-apk.ps1 (or Android
# Studio) from the tracked source. An old debug APK cannot perform the
# functions of a newer source revision, so it is not versioned.
dist/

# Python bytecode caches (make_launcher_icons.py)
__pycache__/
*.py[cod]

# Editor / OS noise
.vscode/
Thumbs.db
desktop.ini

# Release signing key. The keystore is the app's permanent identity — Android
# refuses any update signed by a different key — so it must never be published,
# and must be backed up somewhere outside this repository. Its password lives in
# local.properties, which is ignored above.
*.keystore
*.jks
